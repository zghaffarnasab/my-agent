# Public address of the app (must match the redirect URI in Google Cloud Console)
BASE_URL=https://mail.example.com

# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
DASHBOARD_PASSWORD=change-me-too

# SQLite file inside the Docker volume. For RDS use e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:////data/app.db

# Google Cloud OAuth client (type: Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Cheaper model that reads every email: sorts it, summarises it and finds events
CLASSIFY_MODEL=claude-haiku-4-5-20251001

# Interface language: "en" or "fa" (can also be changed on the Settings page)
DEFAULT_LANGUAGE=en
# Fallback time zone (the Settings page overrides it)
TIMEZONE=Europe/London

# Worker
POLL_INTERVAL_SECONDS=180
# Max new emails sent to the AI per run (the rest waits for the next run)
MAX_EMAILS_PER_RUN=20
# Newsletters / automated mail never get a reply draft. true = still read them for events and summaries
PROCESS_BULK=true
MAX_BULK_PER_RUN=10
# Optional regex of sender addresses to ignore completely, e.g. (@spam\.example|@ads\.example)
SKIP_SENDERS=
# Which emails are read. Add e.g. -category:promotions to exclude a Gmail tab
GMAIL_QUERY=in:inbox is:unread newer_than:2d

# How replies should sound
OWNER_NAME=
REPLY_STYLE=Polite, clear and concise. Professional but warm.
EMAIL_SIGNATURE=
