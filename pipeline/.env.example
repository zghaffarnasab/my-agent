# Copy to pipeline/.env (never commit it) and fill in.

# Password for the pipeline's own Postgres database. Long random string:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=change-me

# Anthropic API key (can be the same key the Gmail assistant uses)
ANTHROPIC_API_KEY=
# Model for the extraction step
EXTRACT_MODEL=claude-sonnet-5-5

# Only needed when running outside Docker (tests, local runs):
# PIPELINE_DATABASE_URL=postgresql://filmdash:change-me@127.0.0.1:5433/filmdash

# Docker network of the Gmail assistant (only change it if the repo folder is not "my-agent")
# APP_NETWORK=my-agent_default
